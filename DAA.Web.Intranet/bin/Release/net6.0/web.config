<?xml version="1.0" encoding="utf-8"?>
<configuration>

	<!-- To customize the asp.net core module uncomment and edit the following section. 
  For more info see https://go.microsoft.com/fwlink/?linkid=838655 -->
	<system.webServer>
		<!--<handlers>
          <remove name="aspNetCore"/>
            <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModule" resourceType="Unspecified"/>
        </handlers>
        <aspNetCore processPath="%LAUNCHER_PATH%" arguments="%LAUNCHER_ARGS%" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" />-->
		<security>
			<!-- 
                preflight заявките използват OPTONS verb и се изпълняват винаги анонимно.
                При използване на Windows Authentication и CORS и двата начина за автентификация трябва да са разрешени, за да е възможно да се изпълнят.
                Ако се забрани anonymous authentication винаги preflight заявката връща грешка 401 и за POST, PUT или DELETE заявка се връща грешка 
                "Access to XMLHttpRequest at 'хххххххххххх' from origin 'ууууууууууу' has been blocked by CORS policy: Response to preflight request doesn't pass access control check: 
                No 'Access-Control-Allow-Origin' header is present on the requested resource." 
                Това може да се настрои и през GUI на IIS
				<authentication>
                    <anonymousAuthentication enabled="true" />
				    <windowsAuthentication enabled="true" />
                </authentication>
            --><!--<aspNetCore processPath="%LAUNCHER_PATH%" arguments="%LAUNCHER_ARGS%" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" />-->

			<authorization>
				<remove users="*" roles="" verbs="" />
				<add accessType="Allow" users="?" verbs="OPTIONS" />
				<add accessType="Allow" users="" roles="NT AUTHORITY\authenticated users" />
			</authorization>

			<requestFiltering removeServerHeader="true">
				<!--100 MB-->
				<!--<requestLimits maxAllowedContentLength="104857600" />-->
				<!-- Max value of uint 4294967295 ~4GB-->
				<requestLimits maxAllowedContentLength="4294967295" />
			</requestFiltering>
		</security>
		<staticContent>
			<clientCache cacheControlMode="DisableCache"/>
		</staticContent>
		<httpProtocol>
		<!--<customHeaders>
        <remove name="X-Powered-By" />
				<add name="Cache-Control" value="no-cache" />
				<add name="Pragma" value="no-cache" />
				<add name="Expires" value="-1" />
				<add name="Referrer-Policy" value="same-origin" />
        <add name="X-Xss-Protection" value="1; mode=block" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Permissions-Policy" value="accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Content-Security-Policy" value="default-src *  data: blob: filesystem: about: ws: wss: 'unsafe-inline' 'unsafe-eval' 'unsafe-dynamic'; script-src * 'unsafe-inline' 'unsafe-eval';  connect-src * 'unsafe-inline';   img-src * data: blob: 'unsafe-inline';                frame-src * blob:;                style-src * data: blob: 'unsafe-inline'; font-src * data: blob: 'unsafe-inline'; report-uri /api/error/cspreport" />
        <add name="Strict-Transport-Security" value="max-age=2592000"/>
	</customHeaders>-->
		</httpProtocol>
	</system.webServer>


</configuration>