<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- To customize the asp.net core module uncomment and edit the following section. 
  For more info see https://go.microsoft.com/fwlink/?linkid=838655 -->
  <system.webServer>
    <security>
      <requestFiltering removeServerHeader="true">
        <!--100 MB-->
        <!--<requestLimits maxAllowedContentLength="104857600" />-->
        <!-- Max value of uint 4294967295 ~4GB-->
        <requestLimits maxAllowedContentLength="4294967295" />
      </requestFiltering>
    </security>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
    <!--<handlers>
      <remove name="aspNetCore"/>
      <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModule" resourceType="Unspecified"/>
    </handlers>
    <aspNetCore processPath="%LAUNCHER_PATH%" arguments="%LAUNCHER_ARGS%" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" />-->
  </system.webServer>
  <location path="">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\DAA.Web.Public.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="AppTest.Public" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
  <location path="Certificate">
    <!--За да сработи секцията system.webServer/security/access, web сървърът трябва да се настрои.
      За IIS Express в <solution folder>\.vs\config\applicationhost.config се добавя следното:
      <location path="DocFlow.Web" overrideMode="Allow">
        <system.webServer>
          <security>
            <access />
          </security>
        </system.webServer>
      </location>
      За IIS същото това се прави през UI по следния начин:
      - отваря се IIS Manager и се избира съответният сайт;
      - в най-долния раздел Management се отваря Configuration Editor;
      - горе вляво се избира Section: system.webServer/security/access;
      - в панела вдясно се натиска Unlock Section.

      В load balanced среда ARR поема логиката по изискване на клиентски сертификат и прихващане не грешките покрай това.
      В този случай тази секция трябва да се премести в web.config файла на ARR сайта, като responseMode="ExecuteURL"
      трябва да се замени с responseMode="Redirect", защото ARR сайтът няма собствен код (контролери и т.н.).-->
    <system.webServer>
      <security>
        <access sslFlags="Ssl, SslNegotiateCert, SslRequireCert" />
      </security>
      <httpErrors errorMode="Custom" existingResponse="Replace">
        <clear />
        <!-- Client certificate required but not selected or none installed. -->
        <error statusCode="403" subStatusCode="7" path="/certificateError/notSelected" responseMode="ExecuteURL" />
        <!-- 403.16: untrusted or invalid; 403.17: expired or future; 403.13: revoked -->
        <!-- Атрибутът prefixLanguageFilePath е фиктивен. Използва се от web.config трансформацията по време на Publish, за да различи този ред от предишния. -->
        <error statusCode="403" prefixLanguageFilePath="" path="/certificateError/invalid" responseMode="ExecuteURL" />
      </httpErrors>
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
