    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="ImageUtil.cs" />
    <Compile Remove="SgmlReader\Main.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Images\DAA-logo.png" />
