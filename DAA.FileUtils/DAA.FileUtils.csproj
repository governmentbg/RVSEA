    <PackageReference Include="MetadataExtractor" Version="2.7.2" />
    <PackageReference Include="MVsDotNetAMSIClient" Version="1.1.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
    <PackageReference Include="System.Drawing.Common" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DAA.Extensions\DAA.Extensions.csproj" />
    <ProjectReference Include="..\DAA.Models\DAA.Models.csproj" />
  </ItemGroup>

</Project>
